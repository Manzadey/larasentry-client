{
    "name": "manzadey/larasentry-client",
    "description": "A lightweight exception tracker client for Laravel.",
    "type": "library",
    "require": {
        "php": ">=8.2",
        "illuminate/support": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/http": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/contracts": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/queue": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/bus": "^10.0|^11.0|^12.0|^13.0"
    },
    "autoload": {
        "psr-4": {
            "Manzadey\\Larasentry\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Manzadey\\Larasentry\\LarasentryServiceProvider"
            ],
            "aliases": {
                "Larasentry": "Manzadey\\Larasentry\\Facades\\Larasentry"
            }
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require-dev": {
        "orchestra/testbench": "^11.3"
    },
    "autoload-dev": {
        "psr-4": {
            "Manzadey\\Larasentry\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    }
}
